# Copie para .env (ou configure no painel da hospedagem) e preencha.
DATABASE_URL=postgres://usuario:senha@host:5432/pulse
# true se o provedor de banco exigir SSL (a maioria dos serviços gerenciados exige)
DATABASE_SSL=false
# Texto aleatório longo (32+ caracteres). Trocar invalida todas as sessões.
SESSION_SECRET=troque-por-um-texto-aleatorio-bem-longo
# Primeiro usuário admin do painel (criado só se não existir nenhum usuário)
ADMIN_LOGIN=admin
ADMIN_SENHA=troque-esta-senha
ADMIN_NOME=Administradora
PORT=3000
# Em desenvolvimento local sem HTTPS, use false. Em produção (HTTPS), deixe sem definir.
# COOKIE_SECURE=false
# AGENDADOR=off  (desliga o processo de hora em hora; não recomendado em produção)
